 {
  "table": "bank_concentration_stat",
  "column": "as_of",
  "comment": "business_meaning: 报告期末日。why_this_way: 资本与暴露必须同一时点；instant 绑定按该列落窗。basis: regulatory"
 },
 {
  "table": "bank_concentration_stat",
  "column": "capital_balance",
  "comment": "business_meaning: 商业银行资本余额（025 分母）。why_this_way: 025 原文用“资本余额”，与 026–030 的“资本净额/一级资本净额”不同，故单列。basis: regulatory"
 },
 {
  "table": "bank_concentration_stat",
  "column": "capital_net",
  "comment": "business_meaning: 资本净额。why_this_way: 028 单一集团客户授信集中度、029 全部关联度原文分母均为资本净额。basis: regulatory"
 },
 {
  "table": "bank_concentration_stat",
  "column": "created_at",
  "comment": ""
 },
 {
  "table": "bank_concentration_stat",
  "column": "data_source",
  "comment": ""
 },
 {
  "table": "bank_concentration_stat",
  "column": "fixture",
  "comment": ""
 },
 {
  "table": "bank_concentration_stat",
  "column": "institution",
  "comment": "business_meaning: 法人机构代码，报表主体。why_this_way: 集中度指标按法人资本与法人最大暴露相除，实体必须是法人机构。basis: regulatory"
 },
 {
  "table": "bank_concentration_stat",
  "column": "max_group_credit",
  "comment": "business_meaning: 最大一家集团客户的授信总额。why_this_way: 028 原文是“授信总额”而非风险暴露或贷款余额。basis: regulatory"
 },
 {
  "table": "bank_concentration_stat",
  "column": "max_group_exposure",
  "comment": "business_meaning: 对最大一组非同业关联客户的风险暴露。why_this_way: 027 的分子按关联组去重后的暴露；单列以区别于单一客户。basis: regulatory"
 },
 {
  "table": "bank_concentration_stat",
  "column": "max_single_customer_exposure",
  "comment": "business_meaning: 对最大单一非同业客户的风险暴露（含表内外）。why_this_way: 026/030 分子按风险暴露而非贷款余额；与 025 的贷款余额分开。basis: regulatory"
 },
 {
  "table": "bank_concentration_stat",
  "column": "max_single_customer_loan",
  "comment": "business_meaning: 对最大单一借款人的贷款余额。why_this_way: 025 分子是“对同一借款人的贷款余额”，报表只保留最大值。basis: regulatory"
 },
 {
  "table": "bank_concentration_stat",
  "column": "tier1_capital_net",
  "comment": "business_meaning: 一级资本净额。why_this_way: 026/027/030 原文分母为一级资本净额；与资本净额分开保存，避免混用。basis: regulatory"
 },
 {
  "table": "bank_concentration_stat",
  "column": "total_related_exposure",
  "comment": "business_meaning: 全部关联方授信总额。why_this_way: 029 是全部关联方汇总值，不是最大值。basis: regulatory"
 },
