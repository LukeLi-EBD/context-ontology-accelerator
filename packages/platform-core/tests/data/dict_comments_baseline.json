 {
  "table": "bank_loan_account",
  "column": "risk_class",
  "comment": ""
 },
 {
  "table": "bank_loan_account",
  "column": "risk_class_end",
  "comment": "business_meaning: 报告期末该账户的五级分类。why_this_way: 迁徙率=期初某类中期末落入更差类的余额/期初该类余额；期末分类是判定迁徙方向的唯一依据。basis: regulatory"
 },
 {
  "table": "bank_loan_account",
  "column": "risk_class_start",
  "comment": "business_meaning: 报告期初该账户的五级分类。why_this_way: 迁徙率分子分母都按“期初分类”分组，期初分类必须与期末分类同表可比。basis: regulatory"
 },
