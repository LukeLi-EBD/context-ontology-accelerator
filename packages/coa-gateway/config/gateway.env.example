# coa-gateway provider configuration sample.
# Copy into the runtime environment (or pass -e to docker run); every key below
# is read by coa_gateway.settings.ProviderSettings.from_env().
#
# One selector per COA interface. `none` = deliberately disabled; an unknown
# name is an error. There is no implicit fallback between providers.

COA_PROVIDER_GRAPH=oxigraph
COA_PROVIDER_VECTOR=in-memory
COA_PROVIDER_EMBEDDING=none
COA_PROVIDER_LLM=none
COA_PROVIDER_QUERY_EXECUTOR=postgres
COA_PROVIDER_SOURCE_CATALOG=json
COA_PROVIDER_CONVERSATION=sqlite
COA_PROVIDER_MEMORY=sqlite
COA_PROVIDER_OBJECT_STORE=fs

# --- graph -------------------------------------------------------------
# oxigraph: SPARQL 1.1 Query at {url}/query
COA_GRAPH_OXIGRAPH_URL=http://oxigraph:7878

# fuseki: either the server root or the dataset query endpoint
# COA_GRAPH_FUSEKI_URL=http://fuseki:3030/ds/sparql
COA_GRAPH_FUSEKI_DATASET=ds

# neptune: SigV4-shaped POST /sparql (form-encoded query, Accept sparql-results+json).
# Needs endpoint + region + access key/secret; session token optional.
# COA_GRAPH_NEPTUNE_ENDPOINT=
# AWS_REGION=cn-north-1
# COA_GRAPH_NEPTUNE_ACCESS_KEY_ID=
# COA_GRAPH_NEPTUNE_SECRET_ACCESS_KEY=
# COA_GRAPH_NEPTUNE_SESSION_TOKEN=

# --- vector ------------------------------------------------------------
# in-memory: JSONL of {"id","text","vector","metadata"}; cosine is computed locally
COA_VECTOR_IN_MEMORY_PATH=/data/coa-gateway/vectors.jsonl

# platform-pgvector: reuse the platform chunk_embedding partition (cosine + model/dim guard)
# COA_VECTOR_PG_DSN=postgresql://platform:CHANGE_ME@postgres:5432/platform
# COA_VECTOR_PG_MODEL=BAAI/bge-m3
# COA_VECTOR_PG_DIMENSIONS=1024

# aoss: declared only; constructing it raises by design (no AWS here)
# COA_VECTOR_AOSS_ENDPOINT=

# --- embedding (interface + multiple implementations) -----------------
# bge-local: platform_core EmbeddingClient over a local BGE/TEI OpenAI-compatible endpoint
# COA_EMBEDDING_BGE_ENDPOINT=http://embedding:80/v1
# COA_EMBEDDING_BGE_MODEL=BAAI/bge-m3
# COA_EMBEDDING_BGE_DIMENSIONS=1024

# external-http: any OpenAI-compatible endpoint; endpoint/model/key/dimensions are ALL required
# COA_EMBEDDING_HTTP_ENDPOINT=https://embed.example/v1
# COA_EMBEDDING_HTTP_MODEL=text-embedding-3-large
# COA_EMBEDDING_HTTP_API_KEY=CHANGE_ME
# COA_EMBEDDING_HTTP_DIMENSIONS=3072

# --- query executor ---------------------------------------------------
# postgres: psycopg 3 (async), one DSN, semaphore-bounded concurrency,
#           server-side statement_timeout + client-side asyncio.timeout
COA_EXECUTOR_POSTGRES_DSN=postgresql://platform:CHANGE_ME@postgres:5432/platform
COA_EXECUTOR_MAX_CONCURRENCY=4
COA_EXECUTOR_CONNECT_TIMEOUT_S=5

# athena: declared only; constructing it raises by design (no AWS here)
# COA_EXECUTOR_ATHENA_WORKGROUP=

# --- source catalog (DataSourceLookup) ---------------------------------
# json: S1's JsonDataSourceLookup over a catalog snapshot; not re-implemented
COA_SOURCE_CATALOG_JSON_PATH=/data/coa-gateway/catalog.json

# smus: declared only; constructing it raises by design (no AWS here)
# COA_SOURCE_CATALOG_SMUS_DOMAIN_ID=

# --- conversation store (N5) ------------------------------------------
# sqlite: one file, sessions survive restarts; no server needed
COA_CONVERSATION_SQLITE_PATH=/data/coa-gateway/conversations.db

# dynamodb: declared only; constructing it raises by design (no AWS here)

# --- memory store (N6) ------------------------------------------------
# sqlite: should point at the SAME file as the conversation store; session_turn
# is the table N5 get_history reads, so appending here makes history non-empty.
# search is a lexical substring match, NOT semantic retrieval; no embedding model.
COA_MEMORY_SQLITE_PATH=/data/coa-gateway/conversations.db

# --- object store (N8) ------------------------------------------------
# fs: <root>/<bucket>/<key> plus a JSON sidecar; presign is not offered
COA_OBJECT_STORE_ROOT=/data/coa-gateway/objects
COA_OBJECT_STORE_MAX_BYTES=67108864

# s3: declared only; constructing it raises by design (no AWS here)

# --- llm (local, in-process) ------------------------------------------
# llama-cpp: one GGUF file loaded in the process; CPU inference, no server and
# no port. Linux needs the cp312 manylinux/linux_x86_64 wheel; it is not baked
# into agent-platform:0.1-s5. converse works; converse_stream/embed raise.
# COA_PROVIDER_LLM=llama-cpp
# COA_LLM_LLAMA_CPP_MODEL_PATH=/data/models/qwen2.5-0.5b-instruct-q4_k_m.gguf
# COA_LLM_LLAMA_CPP_N_CTX=2048
# COA_LLM_LLAMA_CPP_N_THREADS=10
# COA_LLM_LLAMA_CPP_N_BATCH=512

# Note: leaving a selector unset defaults graph=oxigraph, vector=in-memory,
# embedding=none and the rest =none (explicit opt-in).
