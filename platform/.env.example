# Copy to .env (same directory as docker-compose.yml). Never commit .env.
# --- profiles ---
COMPOSE_PROFILES=learn
PLATFORM_RUNTIME_MODE=learn

# --- ports (host side, all bound to 127.0.0.1) ---
POSTGRES_PORT=5432
EMBEDDING_PORT=8081
PLATFORM_PORT=8080
# oxigraph is intentionally NOT mapped to the host (no auth; would bypass GSP governance)

# --- database ---
# Must match database.url in platform.yaml
POSTGRES_PASSWORD=CHANGE_ME

# --- build ---
# PyPI mirror; drop this line to use the official index
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple

# --- LLM provider (Volcengine Ark coding plan) ---
# Coding plan MUST use /api/coding/v3; /api/v3 incurs extra charges.
PLATFORM__LLM__PROVIDER=ark
PLATFORM__LLM__API_KEY=${ARK_API_KEY}
PLATFORM__LLM__BASE_URL=https://ark.cn-beijing.volces.com/api/coding/v3
PLATFORM__LLM__MODEL=deepseek-v4-1-flash-261017
PLATFORM__LLM__TIMEOUT_MS=120000
