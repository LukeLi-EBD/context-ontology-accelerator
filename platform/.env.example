# Copy to .env (same directory as docker-compose.yml). Never commit .env.
# --- stack identity (parallel stacks) ---
# Keep the default for the primary stack. scripts/stack.ps1 sets both this and
# `-p <name>`; if you invoke docker compose manually with -p, set it too so the
# container names stay scoped.
COMPOSE_PROJECT_NAME=agent-platform
# Runtime data root bind-mounted at /data. Parallel stacks MUST use another
# root (e.g. D:/agentABC/data-b); named volumes are already project-scoped.
PLATFORM_DATA_ROOT=D:/agentABC/data

# --- profiles ---
COMPOSE_PROFILES=learn
PLATFORM_RUNTIME_MODE=learn

# --- ports (host side, all bound to 127.0.0.1) ---
POSTGRES_PORT=5432
EMBEDDING_PORT=8081
PLATFORM_PORT=8080
REASONER_PORT=7879
FUSEKI_PORT=3030
# oxigraph is intentionally NOT mapped to the host (no auth; would bypass GSP
# governance). For a short-lived parallel stack, scripts/stack.ps1 -OxigraphPort
# N enables the opt-in override docker-compose.oxigraph-host.yml.
# OXIGRAPH_PORT=7878

# --- database ---
# Must match database.url in platform.yaml
POSTGRES_PASSWORD=CHANGE_ME

# --- build ---
# PyPI mirror; drop this line to use the official index
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple

# --- embedding 档位（background / 默认）---
# 日常入库与验收用这档：embedding 4 核、TEI rayon 4、单容器并发 4、限速 1.0 chunk/s。
# `scripts/burst.ps1 on` 会临时改成 8 核 / RAYON 8 / rate 0（不限速），结束后用
# `scripts/burst.ps1 background` 还原为下面这组值（注意 cpus 需重建 embedding 才生效）。
EMBEDDING_CPUS=4
RAYON_NUM_THREADS=4
MAX_CONCURRENT_REQUESTS=4
EMBED_MAX_CHUNKS_PER_SEC=1.0

# --- LLM provider (Volcengine Ark coding plan) ---
# Coding plan MUST use /api/coding/v3; /api/v3 incurs extra charges.
PLATFORM__LLM__PROVIDER=ark
PLATFORM__LLM__API_KEY=${ARK_API_KEY}
PLATFORM__LLM__BASE_URL=https://ark.cn-beijing.volces.com/api/coding/v3
PLATFORM__LLM__MODEL=deepseek-v4-1-flash-261017
PLATFORM__LLM__TIMEOUT_MS=120000
